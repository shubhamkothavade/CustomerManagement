<style>
    /* Global Styles */
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f4f7fc;
        background-image: url('https://img.freepik.com/free-vector/simple-blue-gradient-background-vector-business_53876-161578.jpg?semt=ais_hybrid&w=740');
        background-size: cover;
        background-repeat: no-repeat;
        background-attachment: fixed;
        color: #333;
        margin: 0;
        padding: 0;
        opacity: 0.9;
    }

    /* Styles for Labels */
    .form-label {
        display: block; /* Ensure labels are on their own line */
        font-weight: bold; /* Make the text bold */
        color: #000; /* Use a strong black color for print */
        margin-bottom: 0.25rem; /* Add a little space below the label */
    }

    /* Styles for Data Display */
    .data-display {
        padding: 0.375rem 0.75rem;
        margin-bottom: 1rem;
        border: 1px solid #ced4da; /* Add a subtle border */
        border-radius: 0.25rem;
        background-color: #f8f9fa; /* Light background for contrast */
    }

    /* Styles for the Back Button */
    .custom-login-btn {
        background-color: white;
        border: 1px solid black; /* Added width and style for the border */
        padding: 8px 20px;
        font-weight: 500;
        transition: 0.3s ease;
        color: black; /* Ensure text color is black */
    }

    /* Print-specific styles */
    @@media print {
        body {
            background-image: none; /* Remove background image for printing */
            color: #000; /* Ensure black text on white background */
            opacity: 1;
        }

        .card {
            border: 1px solid #000 !important;
            box-shadow: none !important;
        }

        .card-header {
            background-color: #eee !important;
            color: #000 !important;
        }

        .btn {
            display: none; /* Hide other buttons when printing */
        }

        .data-display {
            border: 1px solid #000;
            background-color: #fff;
        }

        .form-label {
            color: #000 !important;
        }
        /* Style the back button for printing */
        .custom-login-btn {
            background-color: white !important;
            border: 1px solid black !important;
            color: black !important;
            display: block !important; /* Ensure it's visible */
        }
    }
</style>

<div class="container mt-5">
    <div class="card shadow-lg rounded-4">
        <div class="card-header bg-dark text-white py-3">
            <h4 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Customer Details</h4>
        </div>

        <div class="card-body">
            <div class="row g-4">

                <div class="col-md-4">
                    <label class="form-label">Customer Name</label>
                    <div class="data-display">@Model.CustomerName</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Contact Person</label>
                    <div class="data-display">@Model.ContactPerson</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Phone No</label>
                    <div class="data-display">@Model.PhoneNo</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Mobile No</label>
                    <div class="data-display">@Model.MobileNo</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Address Line 1</label>
                    <div class="data-display">@Model.Address1</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Address Line 2</label>
                    <div class="data-display">@Model.Address2</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Service</label>
                    <div class="data-display">@Model.Service</div>
                </div>
              @*   <div class="col-md-4">
                    <label class="form-label">Financial Year</label>
                    <div class="data-display">@Model.FinancialYear</div>
                </div> *@

                <div class="col-md-4">
                    <label class="form-label">PAN Card No</label>
                    <div class="data-display">@Model.PanCardNo</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">GST No</label>
                    <div class="data-display">@Model.GSTNO</div>
                </div>
               @*  <div class="col-md-4">
                    <label class="form-label">Total Fees</label>
                    <div class="data-display">@Model.TotalFees</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Fees Paid</label>
                    <div class="data-display">@Model.FeesPaid</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Pending Fees</label>
                    <div class="data-display">@Model.PendingFees</div>
                </div> *@

                <div class="col-8">
                    <label class="form-label">Notes</label>
                    <div class="data-display">@Model.Notes</div>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <a asp-action="Index" class="btn custom-login-btn px-4"><i class="bi bi-arrow-left me-1"></i>Back</a>
            </div>
        </div>
    </div>
</div>