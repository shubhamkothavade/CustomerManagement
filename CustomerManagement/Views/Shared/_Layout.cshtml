<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CustomerManagement</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
 
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

     <style>
        :root {
            --sidebar-width: 250px;
            --sidebar-bg: #2c3e50;
            --sidebar-text: #ecf0f1;
            --sidebar-hover: #34495e;
            --content-bg: #f8f9fa;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            min-height: 100vh;
            background-color: var(--content-bg);
        }
        
        /* Sidebar Styles */
        .sidebar {
            width: var(--sidebar-width);
            background-color: var(--sidebar-bg);
            color: var(--sidebar-text);
            position: fixed;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }
        body {
        margin: 0;
        font-family: Arial, sans-serif;
    }

    .sidebar {
        width: 250px;
        height: 100vh;
        background-color: #2c3e50;
        color: white;
        display: flex;
        flex-direction: column;
        position: fixed;
    }

    .sidebar-header {
        padding: 20px;
        text-align: center;
        border-bottom: 1px solid #34495e;
    }

        .sidebar-header h4 {
            margin: 0;
            font-weight: bold;
        }

    .sidebar-welcome {
        padding: 20px;
        border-bottom: 1px solid #34495e;
    }

        .sidebar-welcome p {
            margin: 0;
        }

        .sidebar-welcome .username {
            font-weight: bold;
            margin-top: 5px;
        }

    .sidebar-menu {
        flex: 1;
        padding: 10px 0;
    }

    .menu-item {
        width: 100%;
        padding: 15px 20px;
        background: none;
        border: none;
        color: white;
        text-align: left;
        display: flex;
        align-items: center;
        cursor: pointer;
        transition: background-color 0.3s;
    }

        .menu-item:hover {
            background-color: #34495e;
        }

        .menu-item i {
            margin-right: 10px;
            width: 20px;
            text-align: center;
        }

    .sidebar-footer {
        padding: 15px;
        text-align: center;
        border-top: 1px solid #34495e;
        font-size: 0.9em;
    }

    .main-content {
        margin-left: 250px;
        padding: 20px;
        width: calc(100% - 250px);
    }
  </style>
</head>
<body>
    <!-- Sidebar Navigation -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h4>Customer Management</h4>
        </div>

        <div class="sidebar-welcome">
            <p>Welcome , Admin</p>
            <p class="username">@User.Identity?.Name</p>
        </div>

        <div class="sidebar-menu">
             <a href="@Url.Action("Index", "Customer")" class="menu-item">
                <i class="fas fa-users"></i>
                <span>Customer List</span>
            </a>

@* 
            <a href="@Url.Action("Create", "Customer")" class="menu-item">
                <i class="fas fa-user-plus"></i>
                <span>Add New Customer</span>
            </a> *@

            <a href="@Url.Action("FeeTracking", "FeeRecord")" class="menu-item">
                <i class="fas fa-chart-line"></i>
                <span>Fee Tracking</span>
            </a>
           
        </div>

        <div class="sidebar-footer">
            <form asp-area="" asp-controller="Login" asp-action="Logout" method="post">
                <button type="submit" class="menu-item">
                    <i class="fas fa-power-off"></i>
                    <span>Sign Out</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    
</body>
</html>

@section Scripts {
    <!-- Load jQuery FIRST -->
    <script src="~/lib/jquery/dist/jquery.js"></script>

    <!-- Then jQuery Validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation/dist/additional-methods.min.js"></script>

    <!-- Then Unobtrusive Validation (optional) -->
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

}

@RenderSection("Scripts", required: false)