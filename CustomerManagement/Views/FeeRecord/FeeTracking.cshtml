<!-- Edit Model Script -->
<script>
    var editModal = document.getElementById('editModal');
    editModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;

        // Get data attributes from the clicked button
        var feeRecordId = button.getAttribute('data-id');
        var customerName = button.getAttribute('data-customername');
        var totalFees = button.getAttribute('data-totalfees');

        // Fill modal fields
        editModal.querySelector('#editFeeRecordId').value = feeRecordId;
        editModal.querySelector('#editCustomerName').value = customerName;
        editModal.querySelector('#editTotalFees').value = totalFees;
    });
</script>
<!-- Collect Model Script -->
<script>
        var collectModal = document.getElementById('collectModal');
    collectModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;

        // Get data attributes from the clicked button
        var feeRecordId = button.getAttribute('data-id');
        var customerName = button.getAttribute('data-customername');
        var financialYear = button.getAttribute('data-financialyear');
        var balance = button.getAttribute('data-balance');

        // Fill modal fields
        collectModal.querySelector('#collectFeeRecordId').value = feeRecordId;
        collectModal.querySelector('#collectCustomerName').value = customerName;
        collectModal.querySelector('#collectBalance').value = balance;
        collectModal.querySelector('#collectFinancialYear').value = financialYear;
    });
</script>
<script>
    var feesPaidModal = document.getElementById('feesPaidModal');
    feesPaidModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;

        var customerName = button.getAttribute('data-customername');
        var financialYear = button.getAttribute('data-financialyear');
        var customerId = button.getAttribute('data-customerid');

        document.getElementById('feesPaidCustomerName').textContent = customerName;

        var yearSelect = document.getElementById('feesPaidYearSelect');
        yearSelect.innerHTML = '';

        var option = document.createElement('option');
        option.value = financialYear;
        option.textContent = financialYear;
        yearSelect.appendChild(option);

        loadFeeHistory(customerId, financialYear);

        yearSelect.onchange = function () {
            loadFeeHistory(customerId, yearSelect.value);
        };
    });

    function loadFeeHistory(masterCustomerId, financialYear) {
        fetch(`/FeeRecord/GetFeeHistories?masterCustomerId=${masterCustomerId}&financialYear=${financialYear}`)
            .then(response => response.json())
            .then(data => {
                const tbody = document.getElementById('feesPaidTableBody');
                tbody.innerHTML = '';

                if (data.length === 0) {
                    const row = document.createElement('tr');
                    row.innerHTML = `<td colspan="2" class="text-center">No records found</td>`;
                    tbody.appendChild(row);
                } else {
                    data.forEach(item => {
                        const row = document.createElement('tr');
                        row.innerHTML = `<td>${item.date}</td><td>${item.amount}</td>`;
                        tbody.appendChild(row);
                    });
                }
            })
            .catch(error => {
                console.error('Error fetching fee histories:', error);
            });
    }
</script>
<script>
    function filterCustomers() {
        const input = document.getElementById('customerSearch');
        const filter = input.value.toUpperCase();
        const table = document.querySelector('.table');
        const rows = table.querySelectorAll('tbody tr');

        rows.forEach(row => {
            const customerCell = row.querySelector('td:first-child h6');
            if (customerCell) {
                const txtValue = customerCell.textContent || customerCell.innerText;
                row.style.display = txtValue.toUpperCase().includes(filter) ? '' : 'none';
            }
        });
    }

    function clearSearch() {
        document.getElementById('customerSearch').value = '';
        filterCustomers();
    }
</script>
